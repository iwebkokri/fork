{
  "name": "forksy-backend",
  "version": "1.0.0",
  "description": "FORKSY food delivery platform - core API",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "seed": "ts-node -r tsconfig-paths/register src/database/seed.ts",
    "seed:ratings": "ts-node -r tsconfig-paths/register src/database/seed-ratings.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "openapi:export": "nest build -p tsconfig.openapi.json && node dist-openapi/tools/export-openapi.js",
    "openapi:observe": "node scripts/openapi-observe.mjs",
    "typeorm": "typeorm-ts-node-commonjs -d src/database/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate --pretty",
    "migration:run": "npm run typeorm -- migration:run -t all",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:show": "npm run typeorm -- migration:show",
    "migration:check": "npm run typeorm -- migration:generate --check src/database/migrations/Check",
    "migrate:prod": "node dist/database/migrate",
    "seed:prod": "node dist/database/seed",
    "seed:demo-stores": "ts-node -r tsconfig-paths/register src/database/seed-demo-stores.ts",
    "seed:demo-stores:prod": "node dist/database/seed-demo-stores",
    "seed:demo-locations": "ts-node -r tsconfig-paths/register src/database/seed-demo-locations.ts",
    "seed:demo-locations:prod": "node dist/database/seed-demo-locations"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.0.0",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.0.0",
    "@types/sanitize-html": "^2.16.2",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.0.0",
    "jose": "^6.2.12",
    "otplib": "^12.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.12.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.18.0",
    "socket.io": "^4.8.0",
    "stripe": "^22.6.2",
    "typeorm": "^0.3.20",
    "uuid": "^11.1.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "js-yaml": "5.4.2"
  }
}
